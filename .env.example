# Copy to .env for local dev (docker-compose.dev.yml) or .production.env for prod.
# Settings only read .env when DJANGO_ENV != production; in production the vars come from the environment.

# --- Docker compose (dev) ---
DOCKER_POSTGRES_PORT=5434
DOCKER_BACKEND_PORT=8000

# --- Postgres container ---
POSTGRES_DB=adey
POSTGRES_USER=adey_backend
# required
POSTGRES_PASSWORD=

# --- RabbitMQ container ---
RABBITMQ_DEFAULT_USER=adey_backend
# required
RABBITMQ_DEFAULT_PASS=

# --- Django ---
DJANGO_ENV=development
ENVIRONMENT=development
DEBUG=True
# required
DJANGO_SECRET_KEY=
# required
JWT_SECRET=
ALLOWED_HOSTS=*
CSRF_TRUSTED_ORIGINS=http://localhost:3000
TLS_ENABLED=False
PASSWORD_RESET_TIMEOUT=10800

# --- Databases ---
# required, e.g. postgres://<user>:<password>@db:5432/adey
DATABASE_URL=
# required, can be the same database as DATABASE_URL; needs the pgvector extension
PG_VECTOR_DB_URL=
PG_VECTOR_POOL_SIZE=3
PG_VECTOR_POOL_MAX_OVERFLOW=2

# --- Celery / Channels ---
# required, e.g. amqp://<user>:<password>@broker:5672
CELERY_BROKER_URL=
# required, e.g. amqp://<user>:<password>@broker:5672/asgi
RABBITMQ_ASGI_URL=

# --- Frontend links ---
FRONTEND_URLS=http://localhost:3000/
FRONTEND_DOMAIN=127.0.0.1:3000
FRONTEND_PASSWORD_RESET_PATH=/auth/password/reset/{token}
FRONTEND_EMAIL_VERIFICATION_PATH=

# --- AI: answers ---
# required
OPENAI_API_KEY=
RAG_CHAT_MODEL=gpt-4o-mini
RAG_ANSWER_MODEL=gpt-4o
# router (Jev front door) or rag (skip the router, every message goes to RAG)
AGENT_DEFAULT_PASS=router

# --- AI: Jev router (read by the typesafe-sdk) ---
# required
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
ROUTER_MIN_CONFIDENCE=0.6

# --- Skills ---
# required. Encrypts per-bot skill configs (API keys). Back it up: losing it makes saved configs unreadable.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOOL_CONFIG_KEY=

# --- Payments ---
# required
STRIPE_SECRET_TEST_KEY=

# --- Email ---
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- Storage ---
# required (any value works with FileSystemStorage)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=us-east-2
DEFAULT_FILE_STORAGE=django.core.files.storage.FileSystemStorage
STATICFILES_STORAGE=django.contrib.staticfiles.storage.StaticFilesStorage
